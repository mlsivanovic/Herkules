# Copy to .env.local and fill in the values from the Supabase dashboard
# (Settings → API). The anon key is PUBLIC by design — Row Level Security
# protects the data. Secret keys must never end up in the frontend or repo.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ------------------------------------------------------------------
# Optional: remote Supabase TEST project for RLS integration tests and
# Playwright E2E (copy to .env.test.local). Disable "Confirm email" on
# the test project so signups return a session immediately.
E2E_SUPABASE_URL=https://your-test-project.supabase.co
E2E_SUPABASE_ANON_KEY=your-test-anon-key
